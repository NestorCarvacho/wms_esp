# Base de datos (Railway MySQL suele entregar mysql:// — se convierte automáticamente a aiomysql)
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/wms_esp

# Seguridad (obligatorio en producción)
SECRET_KEY=cambia-esta-clave-en-produccion

# true en local, false en Railway
DEBUG=True

# Orígenes permitidos para CORS (separados por coma). Incluye la URL pública del frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL pública del frontend (enlaces de recuperación de contraseña)
FRONTEND_URL=http://localhost:5173

# Resend — https://resend.com/api-keys
# Gmail/Yahoo NO se pueden registrar como dominio. wms.com requiere DNS real.
#
# OPCIÓN A (recomendada en local): no enviar correo, enlace en consola uvicorn
EMAIL_DEV_LOG_ONLY=True
#
# OPCIÓN B: sandbox Resend (solo envía al email de SU cuenta Resend)
# EMAIL_DEV_LOG_ONLY=False
# EMAIL_FROM=onboarding@resend.dev
#
# OPCIÓN C (producción): dominio propio verificado en resend.com/domains
# EMAIL_DEV_LOG_ONLY=False
# EMAIL_FROM=Khepri Software <noreply@tudominio.com>
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# Bloqueo de login: 3 intentos → 15 min; segundo bloqueo → cuenta bloqueada
LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_EXPIRE_MINUTES=10
# Anti-abuso recuperación: máx. 1 correo/usuario cada 5 min; máx. 5 solicitudes/IP cada 15 min
PASSWORD_RESET_COOLDOWN_MINUTES=5
PASSWORD_RESET_IP_LIMIT=5
PASSWORD_RESET_IP_WINDOW_MINUTES=15
