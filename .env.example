# Base de datos (Railway MySQL suele entregar mysql:// — se convierte automáticamente a aiomysql)
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/wms_esp

# Seguridad (obligatorio en producción)
SECRET_KEY=cambia-esta-clave-en-produccion

# true en local, false en Railway
DEBUG=True

# Orígenes permitidos para CORS (separados por coma). Incluye la URL pública del frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
